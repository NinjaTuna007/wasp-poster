\textbf{Simulation Results:}
\begin{itemize}[leftmargin=1em, itemsep=0.02em]
    \item Mean error: 0.68 m RMSE
    \item Formation error: $< 0.5$ m RMS
    \item 95\% confidence: $< 1.5$ m
    \item Turn success: 98\%
    \item Comm. utilization: $< 0.8\%$
    \item Scalable to 8+ followers
\end{itemize}
\end{tcolorbox}
