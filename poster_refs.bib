@article{Paull2014review,
  author            = {Paull, Liam and Saeedi, Sajad and Seto, Mae and Li, Howard},
  title             = {AUV navigation and localization: A review},
  year              = {2014},
  journal           = {IEEE Journal of Oceanic Engineering},
  volume            = {39},
  number            = {1},
  pages             = {131 – 149},
  doi               = {10.1109/JOE.2013.2278891},
  url               = {https://www.scopus.com/pages/publications/84893706187?inward},
  abstract          = {Autonomous underwater vehicle (AUV) navigation and localization in underwater environments is particularly challenging due to the rapid attenuation of Global Positioning System (GPS) and radio-frequency signals. Underwater communications are low bandwidth and unreliable, and there is no access to a global positioning system. Past approaches to solve the AUV localization problem have employed expensive inertial sensors, used installed beacons in the region of interest, or required periodic surfacing of the AUV. While these methods are useful, their performance is fundamentally limited. Advances in underwater communications and the application of simultaneous localization and mapping (SLAM) technology to the underwater realm have yielded new possibilities in the field. This paper presents a review of the state of the art of AUV navigation and localization, as well as a description of some of the more commonly used methods. In addition, we highlight areas of future research potential. © 2013 IEEE.},
  author_keywords   = {Autonomous underwater vehicles (AUVs); marine navigation; simultaneous localization and mapping},
  keywords          = {Global positioning system; Mathematical techniques; Radio navigation; Robotics; Telecommunication systems; Tracking (position); Underwater acoustics; Autonomous underwater vehicles (AUV); Autonomous underwater vehicles (AUVs); Marine navigation; Radiofrequency signals; Simultaneous localization and mapping; Simultaneous localization and mapping technologies; Underwater communication; Underwater environments; Autonomous underwater vehicles},
  type              = {Review},
  publication_stage = {Final},
  source            = {Scopus},
  note              = {Cited by: 1306}
}

